# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Package manager lock
uv.lock

# Pytest generated files
.coverage

# Generated data (keep directory placeholders via .gitkeep, ignore contents)
data/**/output/*
!data/**/output/.gitkeep

# Coding agent or IDE configurations
.opencode
.pi
.agents

# MLflow generated files
mlflow.db

# Local LM endpoints / secrets (copy from config/lm.example.yaml)
config/*.yaml
!config/*.example.yaml
.env
